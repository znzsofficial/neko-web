{
  "manifest_version": 2,
  "id": "neko.web",
  "version": "1.4.0",
  "name": "Neko 联网",
  "description": "搜索公开网页，读取正文和候选图片，由麦麦看图挑选后随回复发送。",
  "author": {
    "name": "NekoLaska",
    "url": "https://github.com/znzsofficial"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/znzsofficial/neko-web",
    "homepage": "https://github.com/znzsofficial/neko-web",
    "documentation": "https://github.com/znzsofficial/neko-web/blob/main/README.md",
    "issues": "https://github.com/znzsofficial/neko-web/issues"
  },
  "host_application": {
    "min_version": "1.3.5",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.26.0"
    },
    { "type": "python_package", "name": "aiohttp", "version_spec": ">=3.12" }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
